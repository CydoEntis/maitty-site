---
// "Know who needs you": the chips pick a state for bold-puffin's row; left
// alone, the row flips between working and needs you every few seconds.
import { STATES, STATE_KEYS } from "../../lib/states";
---
<section data-status aria-labelledby="s-title" class="border-t border-line bg-card py-[clamp(72px,10vw,128px)]">
  <div class="mx-auto grid max-w-[1280px] grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-center gap-[clamp(32px,5vw,64px)] px-[clamp(16px,4vw,32px)]">
    <div>
      <h2 data-reveal id="s-title" class="m-0 mb-4 font-display text-[clamp(26px,3.6vw,44px)]/[1.12] font-bold tracking-[-.035em] text-strong">Know who needs you.</h2>
      <p data-reveal class="m-0 mb-7 max-w-[50ch] text-muted">Every session shows its state, read from the agent's own hooks where it's connected, and from its screen otherwise. When one waits, Maitty plays a sound and can send an alert to your phone.</p>
      <div role="group" aria-label="Pick a state" class="flex flex-wrap gap-2.5">
        {STATE_KEYS.map((k) => (
          <button type="button" data-state-pick={k} aria-pressed={k === "working" ? "true" : "false"} class="chip flex h-11 items-center gap-2.5 rounded-btn border-2 px-3.5 font-mono text-sm font-bold" style={`--c:${STATES[k].color}`}>
            <span data-spin={k === "working" ? "" : undefined}>{k === "working" ? "⠴" : k === "idle" ? "○" : "●"}</span>{STATES[k].word}
          </button>
        ))}
      </div>
      <p data-state-about class="mt-4 mb-0 text-[15px] text-muted">{STATES.working.about}</p>
    </div>
    <div aria-hidden="true" class="term text-[13px]/[20px] sm:text-sm/[20px]">
      <div class="flex h-[26px] items-center bg-tm-bar px-3"><span class="bg-tm-chip px-1.5 text-tm-strong"><b>SESSIONS</b> 3</span></div>
      <div class="flex flex-col pt-3.5 pb-[18px]">
        <div class="grid grid-cols-[2ch_minmax(0,1fr)_auto] gap-2 px-3.5"><span class="font-bold text-tm-d3">–</span><b class="text-tm-strong">acme-store</b><span class="text-tm-dim">⎇ main</span></div>
        <div data-demo-row data-look="working" class="bg-tm-sel px-3.5 py-0.5 shadow-[inset_2px_0_0_var(--t-teal)]">
          <div class="grid grid-cols-[2ch_minmax(0,1fr)_auto] gap-2 pl-[2ch]"><span data-demo-glyph data-spin class="glyph font-bold">⠴</span><span class="name font-bold">bold-puffin</span><span class="text-tm-dim">✻ 37m</span></div>
          <div data-demo-sub class="sub pl-[calc(4ch+8px)]">1 agent</div>
        </div>
        <div class="grid grid-cols-[2ch_minmax(0,1fr)_auto] gap-2 px-3.5 pt-0.5"><span></span><span class="grid grid-cols-[2ch_minmax(0,1fr)] gap-2"><span data-spin class="font-bold text-tm-teal">⠴</span><span class="font-bold text-tm-work">keen-gull</span></span><span class="text-tm-dim">✻ 4m</span></div>
        <div class="grid grid-cols-[2ch_minmax(0,1fr)_auto] gap-2 px-3.5 pt-0.5"><span></span><span class="grid grid-cols-[2ch_minmax(0,1fr)] gap-2"><span class="text-tm-dim">○</span><span class="text-tm-c9">claude 1</span></span><span class="text-tm-dim">✻ 19m</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .chip { border-color: var(--line); background: var(--bg); color: var(--text); transition: all .15s; }
  .chip:hover { transform: translate(-1px, -1px); }
  .chip[aria-pressed="true"] { border-color: var(--c); background: var(--c); color: var(--ink); box-shadow: 3px 3px 0 var(--hard); }
  [data-look="working"] .glyph { color: var(--t-teal); }
  [data-look="working"] .name { color: var(--t-work); }
  [data-look="working"] .sub { color: var(--t-dim); }
  [data-look="needs"] .glyph { color: var(--t-amber); }
  [data-look="needs"] .name { color: var(--t-strong); }
  [data-look="needs"] .sub { color: var(--t-amber); }
  [data-look="done"] .glyph, [data-look="done"] .name, [data-look="done"] .sub { color: var(--t-green); }
  [data-look="idle"] .glyph, [data-look="idle"] .sub { color: var(--t-dim); }
  [data-look="idle"] .name { color: var(--t-c9); font-weight: 400; }
</style>

<script>
  import "./status";
</script>
