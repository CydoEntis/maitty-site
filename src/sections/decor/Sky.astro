---
// The hero and install backdrops: stars and a moon at Night, a sun and two
// drifting clouds by Day. Pure decoration, hidden from assistive tech.
const rand = (i: number, n: number) => {
  const v = Math.sin(i * 12.9898 + n * 78.233) * 43758.5453;
  return v - Math.floor(v);
};
const stars = Array.from({ length: 46 }, (_, i) => {
  const size = rand(i, 3) < 0.18 ? 2.5 : rand(i, 3) < 0.6 ? 1.6 : 1.1;
  const o = (0.35 + rand(i, 4) * 0.55).toFixed(2);
  return `left:${(rand(i, 1) * 100).toFixed(2)}%;top:${(rand(i, 2) * 62).toFixed(2)}%;width:${size}px;height:${size}px;--o:${o};opacity:${o};animation-duration:${(3 + rand(i, 5) * 5).toFixed(1)}s`;
});
---
<div aria-hidden="true" class="night pointer-events-none absolute inset-0 overflow-hidden">
  {stars.map((style) => <span class="star" style={style}></span>)}
  <span class="moon"></span>
</div>
<div aria-hidden="true" class="day pointer-events-none absolute inset-0 overflow-hidden">
  <span class="sun"></span>
  <span class="cloud cloud-a"></span>
  <span class="cloud cloud-b"></span>
</div>

<style>
  .night { display: var(--sky-night); }
  .day { display: var(--sky-day); }
  .star { position: absolute; border-radius: 50%; background: #e8f1f8; animation: mtTwinkle 4s ease-in-out infinite; }
  .moon {
    position: absolute; right: 7%; top: clamp(28px, 5vw, 64px); width: clamp(40px, 5vw, 64px); aspect-ratio: 1; border-radius: 50%;
    background: #e8f1f8; font-size: clamp(14px, 1.6vw, 20px);
    box-shadow: inset -.35em -.2em 0 0 #c9d6e3, 0 0 60px 18px rgba(232, 241, 248, .10), 0 0 140px 60px rgba(61, 214, 198, .06);
  }
  .sun {
    position: absolute; right: 8%; top: clamp(28px, 5vw, 60px); width: clamp(44px, 5.4vw, 70px); aspect-ratio: 1; border-radius: 50%;
    background: #ffe4a3; box-shadow: 0 0 0 10px rgba(255, 228, 163, .25), 0 0 80px 30px rgba(255, 228, 163, .35);
  }
  .cloud { position: absolute; display: block; background: #fff; }
  .cloud-a {
    right: 16%; top: clamp(70px, 9vw, 120px); width: 120px; height: 30px; border-radius: 30px;
    box-shadow: 24px -14px 0 4px #fff, 58px -6px 0 0 #fff, 0 8px 20px rgba(11, 23, 36, .05);
    animation: mtCloud 26s ease-in-out infinite alternate;
  }
  .cloud-b {
    left: 44%; top: clamp(36px, 5vw, 70px); width: 84px; height: 22px; border-radius: 22px; opacity: .9;
    box-shadow: 18px -10px 0 2px #fff, 40px -4px 0 0 #fff;
    animation: mtCloud 34s ease-in-out -10s infinite alternate-reverse;
  }
</style>
