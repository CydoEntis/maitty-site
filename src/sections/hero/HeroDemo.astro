---
// The interactive app in the hero: five sessions, one waiting for an answer.
// On a phone the session list gives way to a strip of chips above the pane;
// a chip and its list row share data-session, so demo.ts paints both.
import { STATES } from "../../lib/states";
import { ASK, FIRST, GROUPS, INITIAL, OPTIONS, ORDER, clockText, DEFAULT_AGE_S, lookOf, paneGlyph, staticGlyph, subOf } from "./demo-data";
import { transcriptHtml } from "./transcript";

const first = INITIAL[FIRST];
const ask = ASK[FIRST]!;
const needs = Object.values(INITIAL).filter((s) => s.state === "needs").length;
---
<figure aria-label="Interactive Maitty demo" class="term m-0 text-[13px]/[18px]">
  <div data-demo role="group" tabindex="0" aria-label="Demo. Arrow keys choose a session; 1, 2 or 3 answers." class="relative flex flex-col md:grid md:min-h-[470px] md:grid-cols-[minmax(240px,300px)_minmax(0,1fr)]">
    <div role="group" aria-label="Sessions" class="strip hidden gap-1.5 overflow-x-auto border-b border-tm-line bg-tm-bar p-2.5 phone:flex">
      {ORDER.map((id) => {
        const s = INITIAL[id];
        const look = lookOf(s);
        return (
          <button type="button" data-session={id} data-look={look} aria-current={id === FIRST ? "true" : "false"} class="flex h-8 flex-none items-center gap-1.5 rounded-btn border border-tm-line bg-transparent px-2.5 font-bold whitespace-nowrap text-inherit">
            <span data-glyph data-spin={look === "working" ? "" : undefined}>{look === "working" ? "⠴" : staticGlyph(look)}</span><span data-name>{s.name}</span>
          </button>
        );
      })}
    </div>

    <div class="flex flex-col border-tm-teal max-md:border-b md:border-r phone:hidden">
      <div class="flex h-6 items-center justify-between bg-tm-bar px-2.5">
        <span class="bg-tm-chip px-1.5 text-tm-strong"><b>SESSIONS</b> 5</span>
        <span data-needs-badge class="font-bold text-tm-amber transition-opacity duration-300">●{needs}</span>
      </div>
      <div class="flex flex-col gap-3 py-2.5">
        {GROUPS.map((g) => (
          <div class="flex flex-col">
            <div class="grid grid-cols-[2ch_minmax(0,1fr)_auto] gap-2 px-2.5">
              <span class="font-bold" style={`color:${g.dc}`}>–</span><b class="text-tm-strong">{g.name}</b><span class="text-tm-dim">{g.meta}</span>
            </div>
            {g.ids.map((id) => {
              const s = INITIAL[id];
              const look = lookOf(s);
              const sub = subOf(s);
              return (
                <button type="button" data-session={id} data-look={look} aria-current={id === FIRST ? "true" : "false"} class="row block w-full border-0 bg-transparent px-2.5 py-[3px] text-left text-inherit hover:bg-tm-sel max-md:py-2">
                  <span class="grid grid-cols-[2ch_minmax(0,1fr)_auto] gap-2 pl-[2ch]">
                    <span data-glyph data-spin={look === "working" ? "" : undefined} class="font-bold">{look === "working" ? "⠴" : staticGlyph(look)}</span>
                    <span data-name class="truncate">{s.name}</span>
                    <span class="whitespace-nowrap text-tm-dim"><span class="text-tm-green">{s.plus ?? ""}</span> <span class="text-tm-red">{s.minus ?? ""}</span> {s.meta}</span>
                  </span>
                  <span data-sub hidden={!sub} class="block truncate pl-[calc(4ch+8px)]">{sub}</span>
                </button>
              );
            })}
          </div>
        ))}
      </div>
      <div class="mt-auto flex justify-between border-t border-tm-line px-2.5 py-2">
        <span class="term-chip px-2"><b class="text-tm-teal">+</b> New</span>
        <span class="term-chip px-2">Menu</span>
      </div>
    </div>

    <div class="flex min-w-0 flex-col">
      <div class="flex h-6 items-center gap-2 bg-tm-bar px-2.5">
        <span class="truncate bg-tm-teal px-2 font-bold text-tm-ink">1  <span data-pane-name>{first.name}</span></span>
        <span class="font-bold text-tm-teal">+</span>
        <span data-pane-status class="ml-auto font-bold whitespace-nowrap transition-colors duration-300" style={`color:${STATES[first.state].color}`}><span data-pane-glyph>{paneGlyph(first.state)}</span> <span data-pane-word>{STATES[first.state].word}</span></span>
        <span class="text-tm-dim">✕</span>
      </div>
      <div class="flex flex-1 flex-col justify-end gap-0.5 overflow-hidden px-3.5 pt-3 pb-1.5">
        <div data-pane-lines class="flex flex-col gap-0.5" set:html={transcriptHtml(first.base)} />
        <div data-pane-busy hidden class="tline mt-2">
          <span data-busy-star class="text-tm-red">✻ </span><span data-busy-label></span><span data-busy-time class="text-tm-adim"></span>
        </div>
        <div data-pane-ask class="ask mt-2.5 flex flex-col gap-0.5 border-t border-tm-teal pt-2">
          <b class="text-tm-teal">Bash command</b>
          <span data-ask-cmd class="pl-[2ch] text-tm-strong">{ask.cmd}</span>
          <span data-ask-desc class="pl-[2ch] text-tm-adim">{ask.desc}</span>
          <span class="mt-2 text-tm-txt">Allow Bash(<span data-ask-cmd>{ask.cmd}</span>)?</span>
          {OPTIONS.map((label, i) => (
            <button type="button" data-answer={i + 1} class="grid grid-cols-[2ch_minmax(0,1fr)] border-0 bg-transparent py-[3px] text-left hover:text-tm-teal max-md:min-h-11 max-md:items-center" style={`color:${i === 0 ? "var(--t-teal)" : "var(--t-txt)"}`}>
              <span class="font-bold">{i === 0 ? "❯" : " "}</span><span>{label}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="px-3.5 pb-2.5">
        <div class="mb-1.5 border-y border-tm-rule py-[3px]"><span class="text-tm-txt">› </span><span class="caret inline-block h-3.5 w-px bg-tm-txt align-[-2px]"></span></div>
        <div class="flex flex-wrap justify-between gap-x-4 gap-y-1 pl-[2ch] phone:hidden">
          <span><span class="font-bold text-tm-yel">▸▸ auto mode on</span><span class="text-tm-adim"> (shift+tab to cycle) · </span><span class="text-tm-txt">← 1 agent</span></span>
          <span data-pane-clock class="text-tm-adim">{clockText(DEFAULT_AGE_S)}</span>
        </div>
      </div>
    </div>

    <div data-toast hidden class="toast absolute right-4 bottom-[72px] flex max-w-[calc(100%-32px)] min-w-[250px] items-stretch border border-tm-line bg-tm-bar">
      <span class="w-[3px] bg-tm-green"></span>
      <span class="flex flex-col px-3 py-2"><b class="text-tm-green">✓ <span data-toast-title></span></b><span data-toast-detail class="text-tm-c9"></span></span>
    </div>
  </div>
</figure>

<style>
  [data-session][aria-current="true"] { background: var(--t-sel); box-shadow: inset 2px 0 0 var(--t-teal); }
  .row [data-sub] { color: var(--t-dim); }
  [data-look="working"] [data-glyph] { color: var(--t-teal); }
  [data-look="working"] [data-name] { color: var(--t-work); font-weight: 700; }
  [data-look="needs"] [data-glyph] { color: var(--t-amber); }
  [data-look="needs"] [data-name] { color: var(--t-strong); font-weight: 700; }
  .row[data-look="needs"] [data-sub] { color: var(--t-amber); }
  [data-look="done"] [data-glyph], [data-look="done"] [data-name] { color: var(--t-green); font-weight: 700; }
  [data-look="idle"] [data-glyph] { color: var(--t-dim); }
  [data-look="idle"] [data-name] { color: var(--t-c9); }
  .strip { scrollbar-width: none; }
  .strip::-webkit-scrollbar { display: none; }
  :global(.tline) { white-space: pre-wrap; word-break: break-word; animation: mtUp .3s ease-out both; }
  .ask, .toast { animation: mtUp .3s ease-out both; }
  .caret { animation: mtBlink 1s steps(1) infinite; }
  @media (width < 48rem) {
    .toast { bottom: 16px; min-width: 0; }
  }
</style>

<script>
  import "./demo";
</script>
