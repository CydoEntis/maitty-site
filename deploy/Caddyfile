{
	admin off
}

# HTTPS is the host's Caddy; this one only serves files on the loopback port.
:8080 {
	encode zstd gzip
	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The one outside request is the version from GitHub's API. Inline
		# styles stay allowed because the app frames colour each cell inline.
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	# Fonts never change under the same name.
	handle /fonts/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Images are not fingerprinted, so they get a day rather than forever.
	handle /img/* {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# HTML, CSS and JS are re-checked so a deploy shows up straight away.
	handle {
		header Cache-Control "no-cache"
		file_server
	}
}
